{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niagara Scheduler",
  "version": "0.15.0",
  "identifier": "com.niagara.scheduler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Niagara Scheduler",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http: noraimg: http://noraimg.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NjIyODgzNzFFQzgwN0YKUldSL2dPeHhneWhpNmFQbkRHNGZodmg4c1pMUkRpQ24rVE5EM1FtWmsybXdVZCs0Y2lLV2V1OGwK",
      "endpoints": [
        "https://github.com/Duguda/Niagara-Scheduler/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
